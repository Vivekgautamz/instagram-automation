# Virtual environment
.venv/
venv/
ENV/

# Python cache
__pycache__/
*.pyc
*.pyo

# Sensitive credentials & sessions
.env
sessions/
*.session
accounts.json
active_account.txt

# Media files (prevent git repository bloat)
downloads/
reels/new/*.mp4
reels/new/*.mov
reels/new/*.m4v
reels/posted/
images/new/*.jpg
images/new/*.jpeg
images/new/*.png
images/posted/
posted_images/
processed/
logs/
reels_history.db

# Keep empty folder structures with .gitkeep
!.gitkeep
