# Instagram Graph API Credentials (Recommended & Official for Publishing)
# Needs an Instagram Professional Account linked to a Facebook Page
IG_USER_ID=your_instagram_account_id
FB_ACCESS_TOKEN=your_facebook_user_or_page_access_token
GRAPH_API_VERSION=v21.0

# Optional: Public URL where downloaded media can be hosted (e.g. ngrok or AWS S3 / Cloudinary)
# Instagram Graph API requires public video URL to upload reels
PUBLIC_MEDIA_BASE_URL=https://your-public-domain-or-ngrok.io/downloads

# Optional AI Key for Caption & Hashtags rewriting (leave blank to use fallback rules)
GEMINI_API_KEY=
OPENAI_API_KEY=
